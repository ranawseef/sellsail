# Copy to .env and fill in. Never commit real values.
NODE_ENV=production

# 32 random bytes, base64. Encrypts seller API keys, tokens and proxy details.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored keys unreadable; sellers would have to reconnect.
APP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
# Optional, during a key rotation only: the old key, used for decryption.
APP_ENCRYPTION_KEY_PREVIOUS=

# Database (Hostinger MySQL/MariaDB). Either one URL...
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME
# ...or the parts (leave DATABASE_URL empty to use these).
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Public address of the app, used in links sent to Stripe and Amazon.
APP_URL=https://sellsail.io

# Email for sign-up codes and password resets (Hostinger mail, SSL on 465).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@sellsail.io
SMTP_PASSWORD=REPLACE
# Optional: the From line. Defaults to "SellSail <SMTP_USER>".
# MAIL_FROM=SellSail <hello@sellsail.io>

# Tests only: a throwaway database whose tables are dropped on every run.
# TEST_DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/sellsail_test

# Background jobs. Hostinger cron calls /api/cron/tick every minute with
# "Authorization: Bearer <CRON_SECRET>". At least 24 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# Jobs run at once per process (default 3). SCHEDULER=off stops the in-process
# loop; jobs then run only when /api/cron/tick is called.
# JOB_CONCURRENCY=3
# SCHEDULER=off

# Stripe (use test-mode keys until launch). Webhook endpoint:
# https://sellsail.io/api/stripe/webhook with checkout.session.completed and
# customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_STARTER=price_REPLACE
STRIPE_PRICE_GROWTH=price_REPLACE
STRIPE_PRICE_PRO=price_REPLACE

# Amazon SP-API: SellSail's own key sets. Sellers never enter Amazon keys:
# every workspace's Amazon prices are read with these, shared fairly.
# Each numbered set (1..20) is one app with its own rate budget, about 7,000
# listings an hour each, so add more sets as the customer base grows.
# The app needs the Pricing role; the refresh token comes from
# self-authorising it in Seller Central.
SPAPI_1_CLIENT_ID=amzn1.application-oa2-client.REPLACE
SPAPI_1_CLIENT_SECRET=REPLACE
SPAPI_1_REFRESH_TOKEN=Atzr|REPLACE
# SPAPI_2_CLIENT_ID=
# SPAPI_2_CLIENT_SECRET=
# SPAPI_2_REFRESH_TOKEN=
# Optional: send Amazon calls through one proxy, e.g. http://user:pass@1.2.3.4:8080
# SPAPI_PROXY=
